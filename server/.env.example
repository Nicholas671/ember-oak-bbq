# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ember_oak

# JWT Secret (change this to a long random string!)
JWT_SECRET=change_this_to_a_long_random_secret_key_abc123

# Admin notification email
ADMIN_EMAIL=manager@emberandoak.com

# Admin account created by seed.js (REQUIRED for any non-local hosting )
SEED_ADMIN_PASSWORD=dev_password

# Email SMTP settings (for contact form notifications)
# For Gmail: enable 2FA, create an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
